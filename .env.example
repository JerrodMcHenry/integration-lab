# Copy to .env for local development. Never commit real credentials.
APP_ENV=development          # production/staging: dev secrets rejected, mock admin routes disabled
DEFAULT_TENANT_ID=meridian   # only used by the database-less dev fallback
# MAPPING_CONFIG_DIR=app/mapping/configs

# --- CRM integration (IntegrationLab -> mock CRM) ---
CRM_BASE_URL=http://127.0.0.1:8001
# CRM_TOKEN_URL defaults to ${CRM_BASE_URL}/oauth/token
CRM_CLIENT_ID=integrationlab-dev
CRM_CLIENT_SECRET=dev-only-secret
CRM_TIMEOUT_SECONDS=5
CRM_MAX_RETRIES=2            # 0-5, enforced
CRM_BACKOFF_BASE_SECONDS=0.5
CRM_BACKOFF_MAX_SECONDS=4

# --- Mock CRM (must match the CRM_CLIENT_* values above) ---
MOCK_CRM_CLIENT_ID=integrationlab-dev
MOCK_CRM_CLIENT_SECRET=dev-only-secret
MOCK_CRM_TOKEN_TTL_SECONDS=3600

# --- Internal customer management system (IntegrationLab -> mock CMS) ---
INTERNAL_API_BASE_URL=http://127.0.0.1:8002
INTERNAL_API_KEY=dev-only-internal-key
INTERNAL_API_TIMEOUT_SECONDS=5
INTERNAL_API_MAX_RETRIES=2   # 0-5, enforced
INTERNAL_API_BACKOFF_BASE_SECONDS=0.5
INTERNAL_API_BACKOFF_MAX_SECONDS=4

# --- Mock CMS (must match INTERNAL_API_KEY) ---
MOCK_INTERNAL_API_KEY=dev-only-internal-key

# --- Mock admin endpoints: default on in development/test, never in production ---
# MOCK_ADMIN_ENABLED=false

# --- PostgreSQL (docker compose) ---
# Generate a local password, e.g.:  openssl rand -hex 24
POSTGRES_USER=integrationlab
POSTGRES_PASSWORD=
POSTGRES_DB=integrationlab
POSTGRES_HOST_PORT=5434      # bound to 127.0.0.1 only
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/${POSTGRES_DB}
# Integration tests; database name MUST end in _test (tests truncate tables)
TEST_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/integrationlab_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=3
SYNC_LOCK_TIMEOUT_SECONDS=10

# --- Tenant secrets (Milestone 5) ---
# Referenced from tenant_integrations as env:IL_<TENANT>__<NAME>. Each tenant can only
# resolve variables in its own IL_<TENANT>__ namespace. "dev-only" values are refused in production.
IL_MERIDIAN__CRM_CLIENT_SECRET=dev-only-secret
IL_MERIDIAN__CMS_API_KEY=dev-only-internal-key
IL_HARBOR__CRM_CLIENT_SECRET=dev-only-harbor-crm-secret
IL_HARBOR__CMS_API_KEY=dev-only-harbor-cms-key

# --- OIDC (API side). Defaults target the local mock IdP. ---
OIDC_ISSUER=http://localhost:8090
OIDC_AUDIENCE=integrationlab-api
# OIDC_JWKS_URL=               # default: discovered from the issuer
# OIDC_LEEWAY_SECONDS=30
# OIDC_MAX_TOKEN_LIFETIME_SECONDS=3600

# --- Webhook signing secrets (Milestone 6), one per tenant, in the tenant namespace ---
IL_MERIDIAN__WEBHOOK_SECRET=dev-only-whsec-meridian
IL_HARBOR__WEBHOOK_SECRET=dev-only-whsec-harbor
# WEBHOOK_TOLERANCE_SECONDS=300     # replay window
# WEBHOOK_MAX_BODY_BYTES=65536
# WORKER_POLL_INTERVAL_SECONDS=1
# WORKER_BATCH_SIZE=10
# WORKER_LEASE_SECONDS=             # default: 2 x worst-case event duration
# WORKER_MAX_ATTEMPTS=5             # claims per event before it is failed (bounds crash loops)

# --- Retries, metrics, retention (Milestone 7) ---
# RETRY_BASE_DELAY_SECONDS=5        # backoff ceiling for retry n: min(max, base * 2^(n-1)); delay in [ceil/2, ceil]
# RETRY_MAX_DELAY_SECONDS=300
# WORKER_MAX_ATTEMPTS=5             # retries + crash reclaims per event before dead_letter
METRICS_TOKEN=                      # Prometheus /metrics bearer token (>= 32 chars in production); empty = disabled
RETENTION_ENABLED=false             # destructive cleanup stays OFF unless explicitly enabled
# RETENTION_SUCCEEDED_EVENT_DAYS=30
# RETENTION_IGNORED_EVENT_DAYS=7
# RETENTION_SYNC_RECORD_DAYS=90
